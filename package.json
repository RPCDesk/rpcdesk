{
  "name": "rpcdesk",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "sidecar"
  ],
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
